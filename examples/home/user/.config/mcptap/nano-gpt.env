MCP_TAP_API_KEY=sk-nano-....

MCP_TAP_MODEL=openai/gpt-5.6-sol

MCP_TAP_PLAN_MODE_MODEL=openai/gpt-5.6-sol

# Credits API (used by mcptap to check account balance)
# NanoGPT balance/usage: GET https://api.nano-gpt.com/api/v1/balance (or /v1/usage)
MCP_TAP_CREDITS_URL=
# Leave empty to use MCP_TAP_API_KEY
MCP_TAP_CREDITS_API_KEY=
MCP_TAP_USE_CHAT_COMPLETIONS=false
