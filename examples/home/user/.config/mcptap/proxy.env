# Upstream provider to use. One of:
# "abliteration-ai"
# "above"
# "agentrouter"
# "agnes"
# "ai-router"
# "aiand"
# "ainetcafe"
# "aixy"
# "aki-io"
# "alibaba"
# "302ai"
# "aihubmix"
# "llmtr"
# "inferx"
# "kenari"
# "kilo"
# "meta"
# "nano-gpt"
# "nvidia"
# "opencode"
# "openrouter"
# "orcarouter"
# "pendra"
# "requesty"
# "runinfra"
# "tokenrouter"
# "unorouter"
# "vercel"
# "zenmux"
# "openrouter"
MCPTAP_UPSTREAM_PROVIDER="openrouter"

# Provider used for Pareto benchmark data.
MCPTAP_PARETO_PROVIDER=openrouter

MCPTAP_LISTEN_HOST=127.0.0.1
MCPTAP_LISTEN_PORT=8787

# Optional. Leave empty to let OpenRouter choose an endpoint for the forced model.
# To pin one endpoint provider, put its OpenRouter provider slug here.
MCPTAP_OPENROUTER_PROVIDER=

# With :floor, this prevents trying another endpoint when the cheapest one fails.
MCPTAP_OPENROUTER_DISABLE_PROVIDER_FALLBACKS=0

MCPTAP_PLAN_MODE_MAX_INPUT_SIZE=300000

MCPTAP_LOG_LEVEL=INFO
#MCPTAP_LOG_LEVEL=DEBUG
#MCPTAP_LOG_FILE=/tmp/mcptap.log

#MCPTAP_INTERCEPT_YAML=@/home/user/.config/mcptap/mcp-intercept.yaml
MCPTAP_INTERCEPT_YAML=
MCPTAP_INTERCEPT_TOOL_TIMEOUT=300
MCPTAP_INTERCEPT_MAX_ITERATIONS=8

#MCPTAP_PER_MODEL_YAML=@/home/user/.config/mcptap/per-model.yaml
MCPTAP_PER_MODEL_YAML=

# Optional tool-call hook. When set, MCPTap runs this script before
# each batch of client tool calls to decide whether to allow or block them.
#MCPTAP_USE_TOOL_HOOK=/home/user/.config/mcptap/use_tool_hook.py
MCPTAP_USE_TOOL_HOOK=
MCPTAP_USE_TOOL_HOOK_TIMEOUT=30

# When set, the proxy injects a synthetic call to this tool name before
# running the hook (e.g. get_goal). When empty, the hook runs immediately
# without injecting any synthetic tool call.
#MCPTAP_USE_TOOL_HOOK_SYNTHETIC_TOOL=get_goal
MCPTAP_USE_TOOL_HOOK_SYNTHETIC_TOOL=

# Directory for per-session data.
MCPTAP_PER_SESSION_DIR=/tmp/mcptap/per_session

# Optional environment variables for MCP tools launched by mcp-intercept.yaml.
LLM_COUNCIL_API_TOKEN="41a.....b20"
LLM_COUNCIL_CONFIG="/home/user/.config/llm-council/llm_council.yaml"
LLM_COUNCIL_OPENROUTER_API_KEY="sk-or-v1-df1.....24e"
LLM_COUNCIL_REQUESTY_API_KEY="rqsty-sk-ki1.....2QY="

# Credits cross-validation
# How often (seconds) to check provider credits API vs local cost sum
MCPTAP_CREDITS_CHECK_INTERVAL=300
# Max allowed discrepancy (USD) before flagging as mismatch
MCPTAP_CREDITS_DISCREPANCY_THRESHOLD=0.01

# Telegram alerts for credit mismatches
MCPTAP_TELEGRAM_BOT_TOKEN=824....829:AAHG9Do-Z4l................KFYC_SAo
MCPTAP_TELEGRAM_CHAT_ID=76......31
MCPTAP_TELEGRAM_ALERT_LEVEL=mismatch
