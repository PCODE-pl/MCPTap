MCP_TAP_API_KEY=llmtr-....

MCP_TAP_MODEL=zai/glm-5.2

MCP_TAP_PLAN_MODE_MODEL=zai/glm-5.2

# LLMTR models exposed only through /v1/chat/completions need the Responses
# to Chat Completions compatibility adapter.
MCP_TAP_USE_CHAT_COMPLETIONS=true

# Credits API (used by mcptap to check account balance)
# LLMTR balance is available in the Dashboard > Faturalandırma page; no public credits API.
MCP_TAP_CREDITS_URL=
# Leave empty to use MCP_TAP_API_KEY
MCP_TAP_CREDITS_API_KEY=
